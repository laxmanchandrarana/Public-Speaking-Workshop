# Django Configuration
DEBUG=False
SECRET_KEY=generate-a-secure-random-secret-key-here
ALLOWED_HOSTS=psw-api.lcrana.in,localhost,127.0.0.1,backend

# PostgreSQL Database Configuration
DB_NAME=public_speaking_workshop
DB_USER=ubuntu
DB_PASSWORD=
DB_HOST=/var/run/postgresql
DB_PORT=5432

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=https://psw.lcrana.in,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://psw.lcrana.in,https://psw-api.lcrana.in

# External Automation Configuration (n8n Webhook)
AUTOMATION_WEBHOOK_URL=https://n8n.atmakriti.com/webhook/public-speaking-workshop
AUTOMATION_WEBHOOK_SECRET=your-n8n-webhook-secret-token

# Workshop Timezone & Schedulers
TIME_ZONE=Asia/Kolkata
OUTBOX_LEASE_TIMEOUT_SECONDS=300
REMINDER_LEASE_TIMEOUT_SECONDS=300
REMINDER_PAST_DUE_THRESHOLD_MINUTES=15

# WhatsApp / Evolution API Configuration
EVOLUTION_API_URL=https://evolution.lcrana.in
EVOLUTION_API_KEY=your-evolution-instance-token
EVOLUTION_INSTANCE_NAME=LCR
