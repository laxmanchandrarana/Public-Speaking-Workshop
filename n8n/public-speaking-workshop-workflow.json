    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst raw = items[0].json.raw_event || items[0].json;\nconst data = raw.data || {};\nconst reg = data.registration || {};\nconst ws = data.workshop || {};\nconst notifs = data.notifications || {};\nconst msgs = data.messages || {};\n\nconst eventType = raw.event_type;\nconst isConfirmation = eventType === \"registration.created\";\n\n// Select notification IDs based on event type\nconst emailNotificationId = isConfirmation\n  ? notifs.confirmation_email_id\n  : notifs.reminder_email_id;\n\nconst whatsappNotificationId = isConfirmation\n  ? notifs.confirmation_whatsapp_id\n  : notifs.reminder_whatsapp_id;\n\n// Select and format email subject\nconst emailSubject = isConfirmation\n  ? \"Public Speaking Workshop \u2014 Registration Confirmed\"\n  : \"Reminder: Public Speaking Workshop starts in 15 minutes\";\n\n// Plain-text email body (fallback)\nconst emailBody = isConfirmation\n  ? `Hello ${reg.full_name || \"there\"},\n\nYour registration for the ${ws.title || \"Public Speaking Workshop\"} is confirmed.\n\nDate: 18 September 2026\nTime: 3:30 PM ${ws.timezone || \"Asia/Kolkata\"}\n\nWe will send you a reminder 15 minutes before the session starts.\n\nRegards,\nPublic Speaking Workshop Team`\n  : `Hello ${reg.full_name || \"there\"},\n\nThis is a reminder that the ${ws.title || \"Public Speaking Workshop\"} starts in 15 minutes (3:30 PM ${ws.timezone || \"Asia/Kolkata\"})!\n\nRegards,\nPublic Speaking Workshop Team`;\n\n// Modern, responsive HTML email template\nconst emailHtml = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Public Speaking Workshop</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; color: #1f2937;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #f3f4f6; padding: 32px 16px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 580px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);\">\n          <!-- Header Banner -->\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); padding: 36px 32px; text-align: center;\">\n              <span style=\"display: inline-block; background-color: rgba(255, 255, 255, 0.2); color: #ffffff; padding: 4px 14px; border-radius: 9999px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;\">\n                ${isConfirmation ? \"Registration Confirmed\" : \"Workshop Reminder\"}\n              </span>\n              <h1 style=\"color: #ffffff; margin: 8px 0 0 0; font-size: 26px; font-weight: 700; line-height: 1.3;\">\n                ${ws.title || \"Public Speaking Workshop\"}\n              </h1>\n            </td>\n          </tr>\n          <!-- Content Body -->\n          <tr>\n            <td style=\"padding: 36px 32px;\">\n              <p style=\"font-size: 18px; font-weight: 600; color: #111827; margin: 0 0 16px 0;\">\n                Hello ${reg.full_name || \"there\"},\n              </p>\n              <p style=\"font-size: 15px; line-height: 1.6; color: #4b5563; margin: 0 0 24px 0;\">\n                ${isConfirmation\n                  ? `Your seat for the <strong>${ws.title || \"Public Speaking Workshop\"}</strong> has been successfully confirmed! Below are your session details:`\n                  : `This is a friendly reminder that the <strong>${ws.title || \"Public Speaking Workshop\"}</strong> will begin in <strong>15 minutes</strong>!`\n                }\n              </p>\n              <!-- Session Details Card -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; margin-bottom: 28px;\">\n                <tr>\n                  <td style=\"padding: 20px 24px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                      <tr>\n                        <td width=\"32\" valign=\"top\" style=\"font-size: 18px;\">\ud83d\udcc5</td>\n                        <td style=\"padding-bottom: 14px;\">\n                          <div style=\"font-size: 12px; text-transform: uppercase; color: #6b7280; font-weight: 600; letter-spacing: 0.5px;\">Date</div>\n                          <div style=\"font-size: 15px; font-weight: 600; color: #111827; margin-top: 2px;\">18 September 2026</div>\n                        </td>\n                      </tr>\n                      <tr>\n                        <td width=\"32\" valign=\"top\" style=\"font-size: 18px;\">\u23f0</td>\n                        <td style=\"padding-bottom: 14px;\">\n                          <div style=\"font-size: 12px; text-transform: uppercase; color: #6b7280; font-weight: 600; letter-spacing: 0.5px;\">Time</div>\n                          <div style=\"font-size: 15px; font-weight: 600; color: #111827; margin-top: 2px;\">3:30 PM IST (${ws.timezone || \"Asia/Kolkata\"})</div>\n                        </td>\n                      </tr>\n                      <tr>\n                        <td width=\"32\" valign=\"top\" style=\"font-size: 18px;\">\ud83d\udd14</td>\n                        <td>\n                          <div style=\"font-size: 12px; text-transform: uppercase; color: #6b7280; font-weight: 600; letter-spacing: 0.5px;\">Reminder</div>\n                          <div style=\"font-size: 15px; font-weight: 600; color: #111827; margin-top: 2px;\">15 minutes before (3:15 PM IST) via WhatsApp & Email</div>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n              <!-- Notice Box -->\n              <div style=\"background-color: #eef2ff; border-left: 4px solid #4f46e5; border-radius: 4px 8px 8px 4px; padding: 14px 18px; margin-bottom: 28px;\">\n                <p style=\"margin: 0; font-size: 14px; line-height: 1.5; color: #3730a3;\">\n                  ${isConfirmation\n                    ? \"<strong>Note:</strong> An automated reminder will be sent 15 minutes before the session starts with joining instructions.\"\n                    : \"<strong>The session is starting soon!</strong> Please prepare your audio and video to join the live session.\"\n                  }\n                </p>\n              </div>\n              <p style=\"font-size: 15px; color: #4b5563; margin: 0; line-height: 1.5;\">\n                Warm regards,<br>\n                <strong style=\"color: #111827;\">Public Speaking Workshop Team</strong>\n              </p>\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color: #f9fafb; padding: 20px 32px; border-top: 1px solid #f3f4f6; text-align: center;\">\n              <p style=\"font-size: 12px; color: #9ca3af; margin: 0;\">\n                You received this email because you registered for the Public Speaking Workshop with <strong>${reg.email || \"\"}</strong>.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n\n// WhatsApp message\nlet whatsappText = msgs.whatsapp_text;\nif (!whatsappText) {\n  if (isConfirmation) {\n    whatsappText = `Hi ${reg.full_name}, your registration for ${ws.title || \"Public Speaking Workshop\"} is confirmed! Date: 18 September 2026, 3:30 PM ${ws.timezone || \"Asia/Kolkata\"}. We will send a reminder 15 minutes before the session starts.`;\n  } else {\n    whatsappText = `Hi ${reg.full_name}, reminder: ${ws.title || \"Public Speaking Workshop\"} starts in 15 minutes (3:30 PM ${ws.timezone || \"Asia/Kolkata\"})!`;\n  }\n}\n\nreturn [{\n  json: {\n    event_id: raw.event_id,\n    event_type: eventType,\n    version: raw.version || \"1.0\",\n    occurred_at: raw.occurred_at,\n    registration_id: reg.id,\n    full_name: reg.full_name,\n    email: reg.email,\n    phone_number: reg.phone_number,\n    workshop_id: ws.id,\n    workshop_title: ws.title || \"Public Speaking Workshop\",\n    scheduled_at: ws.scheduled_at_iso || \"2026-09-18T15:30:00+05:30\",\n    reminder_at: ws.reminder_at_iso || \"2026-09-18T15:15:00+05:30\",\n    timezone: ws.timezone || \"Asia/Kolkata\",\n    confirmation_email_id: notifs.confirmation_email_id,\n    confirmation_whatsapp_id: notifs.confirmation_whatsapp_id,\n    reminder_email_id: notifs.reminder_email_id,\n    reminder_whatsapp_id: notifs.reminder_whatsapp_id,\n    email_notification_id: emailNotificationId,\n    whatsapp_notification_id: whatsappNotificationId,\n    email_subject: emailSubject,\n    email_body: emailBody,\n    email_html: emailHtml,\n    whatsapp_text: whatsappText,\n    original_event: raw\n  }\n}];"
      },
