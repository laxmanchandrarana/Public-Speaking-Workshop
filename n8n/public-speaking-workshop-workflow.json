    {
      "parameters": {
        "jsCode": "// Validate incoming event from Django outbox\nconst items = $input.all();\nif (!items || items.length === 0) {\n  return [{ json: { is_valid: false, error_reason: \"Empty payload received\", raw_event: {} } }];\n}\n\nconst body = items[0].json.body || items[0].json;\n\n// Verify required top-level envelope fields\nconst requiredEnvelope = [\"event_id\", \"event_type\", \"version\", \"occurred_at\", \"data\"];\nfor (const field of requiredEnvelope) {\n  if (!body[field]) {\n    return [{\n      json: {\n        is_valid: false,\n        error_reason: `Missing required field: ${field}`,\n        raw_event: body\n      }\n    }];\n  }\n}\n\n// Verify supported event types\nconst supportedTypes = [\"registration.created\", \"registration.reminder\"];\nif (!supportedTypes.includes(body.event_type)) {\n  return [{\n    json: {\n      is_valid: false,\n      error_reason: `Unsupported event_type: '${body.event_type}'. Supported: ${supportedTypes.join(', ')}`,\n      raw_event: body\n    }\n  }];\n}\n\n// Verify core data sub-objects\nconst data = body.data || {};\nif (!data.registration || !data.workshop || !data.notifications) {\n  return [{\n    json: {\n      is_valid: false,\n      error_reason: \"Malformed payload: missing data.registration, data.workshop, or data.notifications\",\n      raw_event: body\n    }\n  }];\n}\n\nconst reg = data.registration;\nif (!reg.email || !reg.full_name || !reg.phone_number) {\n  return [{\n    json: {\n      is_valid: false,\n      error_reason: \"data.registration missing required fields: email, full_name, or phone_number\",\n      raw_event: body\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    is_valid: true,\n    error_reason: null,\n    raw_event: body\n  }\n}];"
      },
